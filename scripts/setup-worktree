#!/bin/bash
if [[ -d docs ]]; then
  if [[ -f docs/.git ]]; then
    echo -e "\e[32mdocs/.git is a worktree reference.\e[m" >&2
    grep -qE '^gitdir\:' docs/.git && exit 0
  elif [[ -d docs/.git ]]; then
    echo -e "\e[32mdocs/.git is a folder instead of worktree reference, acceptable.\e[m" >&2
    exit 0
  else
    echo -e "\e[33mdocs/.git does not exist, pruning the folder.\e[m" >&2
    rm -r docs
  fi
elif [[ -f docs ]]; then
  echo -e "\e[31mdocs is not a folder, it is a reserved folder for scripting, removing.\e[m" >&2
  rm docs
fi

branch=docs
opts=(-b "${branch}")
refspec=

if (git branch -a --format='%(refname:short)' | grep -qF -e "origin/${branch}" -e "${branch}"); then
  refspec=origin/${branch}
else
  opts+=(--orphan)
fi

git worktree add "${opts[@]}" docs "${refspec}"
