#!/bin/bash
INCIDENT_LIST=()
declare -A INCIDENT_NAME
declare -A INCIDENT_START_TIME
declare -A INCIDENT_END_TIME

xml_tag() {
  TAG="${@:1:1}"
  ATTR=
  LAST=

  if [[ $# -ge 3 ]]; then
    ATTRS=( "${@:2:$(($#-2))}" )
    for attr in "${ATTRS[@]}"; do
      ATTR="${ATTR:+${ATTR} }${attr}"
    done
    unset ATTRS
  fi

  [[ $# -ge 2 ]] && LAST="${@:$#:1}"

  echo "<${TAG} ${ATTR}>${LAST}</${TAG}>"
}

for incident_dir in incidents/*; do
  if [[ ! -d ${incident_dir} ]]; then
    echo -e "\e[31mIncident ${incident_dir} was supposed to be a folder!\e[m" >&2
    continue
  fi

  key=$(basename ${incident_dir})
  name=
  start=
  end=

  [[ -f ${incident_dir}/name ]] && name=$(cat ${incident_dir}/name)
  start=$(cat ${incident_dir}/start)
  [[ -f ${incident_dir}/end ]] && end=$(cat ${incident_dir}/end)

  if [[ ! -f ${incident_dir}/start ]]; then
    echo "Incident ${key} is not a valid incident." >&2
  fi

  INCIDENT_LIST+=("${key}")
  INCIDENT_NAME+=(["${key}"]="${name:-${key}}")
  INCIDENT_START_TIME+=(["${key}"]="${start}")
  INCIDENT_END_TIME+=(["${key}"]="${end}")
done

DURATION_KEYS=(hour min sec)

INCIDENT_HTML_LIST=
CURRENT_TIME=$(date +%s)
for incident in "${INCIDENT_LIST[@]}"; do
  start_time="${INCIDENT_START_TIME[${incident}]}"
  end_time="${INCIDENT_END_TIME[${incident}]}"
  if [[ -n ${end_time} ]]; then
    duration=$((${end_time} - ${start_time}))
  else
    duration=$((${CURRENT_TIME} - ${start_time}))
  fi

  duration_keys=( ${DURATION_KEYS[@]} )
  duration_parts=(
    $(( (${duration} / 3600) ))
    $(( (${duration} / 60) % 60 ))
    $(( ${duration} % 60 ))
  )
  
  while [[ ${duration_parts[0]} -le 0 ]] && [[ ${#duration_parts[@]} -gt 1 ]]; do
    duration_parts=(${duration_parts[@]:1})
    duration_keys=(${duration_keys[@]:1})
  done

  if [[ ${duration_parts[0]} -ge 1000 ]]; then
    focus_size=2.0
  elif [[ ${duration_parts[0]} -ge 500 ]]; then
    focus_size=1.8
  elif [[ ${duration_parts[0]} -ge 100 ]]; then
    focus_size=1.6
  elif [[ ${duration_parts[0]} -ge 60 ]]; then
    focus_size=1.4
  elif [[ ${duration_parts[0]} -ge 30 ]]; then
    focus_size=1.3
  elif [[ ${#duration_parts} -gt 1 ]]; then
    focus_size=1.2
  else
    focus_size=1.1
  fi

  duration_html=
  duration_html+=$(xml_tag span style="'font-size: ${focus_size}em; color: red'" "${duration_parts[0]}")
  duration_html="${duration_html:+${duration_html} }${duration_keys[0]}"
  duration_parts=(${duration_parts[@]:1})
  duration_keys=(${duration_keys[@]:1})

  while [[ ${#duration_parts[@]} -ge 1 ]]; do
    if [[ ${duration_parts[0]} -gt 0 ]]; then
      duration_html="${duration_html:+${duration_html} }${duration_parts[0]} ${duration_keys[0]}"
    fi

    duration_parts=(${duration_parts[@]:1})
    duration_keys=(${duration_keys[@]:1})
  done

  tr=
  tr+=$(xml_tag td "${INCIDENT_NAME[${incident}]}")
  tr+=$(xml_tag td data-actual-time=${start_time} "$(date -d @${start_time} +'%Y-%m-%d %H:%M:%S')")
  if [[ -n "${end_time}" ]]; then
    tr+=$(xml_tag td data-actual-time=${end_time} "$(date -d @${end_time} +'%Y-%m-%d %H:%M:%S')")
  else
    tr+=$(xml_tag td)
  fi
  tr+=$(xml_tag td "${duration_html}")

  tr=$(xml_tag tr "${tr}")
  INCIDENT_HTML_LIST="${INCIDENT_HTML_LIST}${tr}"
done

incident_head=$(xml_tag td name)$(xml_tag td since)$(xml_tag td end)$(xml_tag td duration)
incident_head=$(xml_tag tr "${incident_head}")
incident_head=$(xml_tag thead "${incident_head}")

script_adjust_time=$(cat <<-EOF
'use strict';
document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('[data-actual-time]').forEach(function(elm){
    var time = parseInt(elm.dataset.actualTime, 10) * 1000;
    var date = new Date(time);

    elm.textContent = [
      String(date.getFullYear()).padStart(4, '0'),
      String(date.getMonth() + 1).padStart(2, '0'),
      String(date.getDate()).padStart(2, '0')
    ].join('-') + ' ' + [
      String(date.getHours()).padStart(2, '0'),
      String(date.getMinutes()).padStart(2, '0'),
      String(date.getSeconds()).padStart(2, '0'),
    ].join(':');
  });
});
EOF
)

script_auto_ticker=$(cat <<-'EOF'
'use strict';
document.addEventListener('DOMContentLoaded', function(){
  function durationHTML(elm, deltaTime) {
    var parts = [
      Math.floor(deltaTime / 3600),
      Math.floor(deltaTime / 60) % 60,
      Math.floor(deltaTime / 1) % 60,
    ];
    var keys = ['hour', 'min', 'sec'];

    for (; parts[0] <= 0 && parts.length > 1; parts.shift(), keys.shift());

    var head_scale;
    if (parts[0] >= 1000) head_scale = 2.0;
    else if (parts[0] >= 500) head_scale = 1.8;
    else if (parts[0] >= 100) head_scale = 1.6;
    else if (parts[0] >=  60) head_scale = 1.4;
    else if (parts[0] >=  30) head_scale = 1.3;
    else if (parts.length > 1) head_scale = 1.2;
    else head_scale = 1.1;

    var durationElm = elm.querySelector('td:nth-of-type(4)');
    while (durationElm.childNodes.length) durationElm.childNodes[0].remove();

    var childs = [];
    childs.push(document.createElement('span'));
    childs[childs.length - 1].style.fontSize = `${head_scale}em`;
    childs[childs.length - 1].style.color = 'red';
    childs[childs.length - 1].textContent = parts.shift();
    childs.push(document.createTextNode(` ${keys.shift()}`));

    while (parts.length) {
      childs.push(document.createTextNode(` ${parts.shift()}`));
      childs.push(document.createTextNode(` ${keys.shift()}`));
    }

    while (childs.length) durationElm.appendChild(childs.shift());
  }

  function preciseInterval(callback, ndate) {
    var cdate = new Date();
    var dtime = ndate.getTime() - cdate.getTime();

    setTimeout(callback, dtime);
  }

  function startTimer() {
    var size = 1 * 1000;
    var cdate = new Date();
    var ndate = new Date(Math.ceil(cdate.getTime() / size) * size);
    var startEndCount = Object.seal([0, 0]);

    document.querySelectorAll('tbody tr').forEach(function(rowElm){
      var startTime = rowElm.querySelector('td:nth-child(2)').dataset.actualTime;
      var endTime = rowElm.querySelector('td:nth-child(3)').dataset.actualTime;
      var duration;

      startEndCount[0] += 1;

      if (typeof endTime === 'string') {
        duration = parseInt(endTime, 10) - parseInt(startTime, 10);
        starTEndCount[1] += 1;
      } else {
        duration = Math.floor(cdate.getTime() / 1000) - parseInt(startTime, 10);
      }

      durationHTML(rowElm, duration);
    });

    if (startEndCount[0] > startEndCount[1])
      preciseInterval(startTimer, ndate);
  }

  startTimer();
});
EOF
)

script_auto_refresh=$(cat <<-'EOF'
'use strict';
document.addEventListener('DOMContentLoaded', function(){
  var elm = document.getElementById('generated-time');
  var hour = 3600000;

  var cdate = new Date();
  var ctime = cdate.getTime();
  var otime = ((Math.ceil((parseInt(elm.dataset.actualTime, 10) % 3600) / 60) + 1) * 60) * 1000;
  var ptime = Math.floor(cdate / hour) * hour + otime;
  var ntime = ptime + hour;

  var dtime = ntime - ctime;
  setTimeout(function(){ window.location.reload(); }, dtime);
});
EOF
)

footer_timestamp=$(xml_tag span id=generated-time data-actual-time=${CURRENT_TIME} "$(date -d @${CURRENT_TIME} +'%Y-%m-%d %H:%M:%S')")
footer_time=(
  'Time has been adjusted to your system timezone.'
  '<br>'
  "Generated at ${footer_timestamp}."
)

html=${incident_head}$(xml_tag tbody "${INCIDENT_HTML_LIST}")
html=$(xml_tag p 'Here are the list of incidents that have been tracked so far:')$(xml_tag table "${html}")$(xml_tag p "${footer_time[*]}")$(xml_tag script "${script_adjust_time}")$(xml_tag script "${script_auto_ticker}")$(xml_tag script "${script_auto_refresh}")
html=$(xml_tag body "${html}")

echo "${html}" > docs/index.html
